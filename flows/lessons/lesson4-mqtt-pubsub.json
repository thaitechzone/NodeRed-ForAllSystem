[
    {
        "id": "tab-l4",
        "type": "tab",
        "label": "L4: MQTT Pub/Sub",
        "disabled": false,
        "info": "บทเรียนที่ 4: MQTT Publish/Subscribe\nส่ง (Publish) และรับ (Subscribe) ข้อมูลผ่าน MQTT Broker\n\nหมายเหตุ Broker:\n- Docker: ใช้ hostname = mosquitto, port 1883\n- Standalone: ใช้ hostname = localhost, port 1883"
    },

    {
        "id": "l4-mqtt-broker",
        "type": "mqtt-broker",
        "name": "Mosquitto Local",
        "broker": "localhost",
        "port": "1883",
        "clientid": "nodered-lesson4",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "willMsg": {},
        "userProps": "",
        "sessionExpiry": ""
    },

    {
        "id": "l4-cmt-pub",
        "type": "comment",
        "z": "tab-l4",
        "name": "── PUBLISHER: ส่งข้อมูลออกไป ──",
        "info": "",
        "x": 190,
        "y": 40,
        "wires": []
    },
    {
        "id": "l4-inj-manual",
        "type": "inject",
        "z": "tab-l4",
        "name": "ส่ง Sensor Data (กดเอง)",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "factory/sensor/mc01",
        "payload": "{\"temperature\":28.5,\"humidity\":60,\"status\":\"NORMAL\"}",
        "payloadType": "json",
        "x": 180,
        "y": 100,
        "wires": [["l4-fn-pub"]]
    },
    {
        "id": "l4-inj-auto",
        "type": "inject",
        "z": "tab-l4",
        "name": "ส่งซ้ำทุก 5 วิ (Auto)",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "5",
        "crontab": "",
        "once": true,
        "onceDelay": 1,
        "topic": "factory/sensor/mc01",
        "payload": "",
        "payloadType": "date",
        "x": 180,
        "y": 160,
        "wires": [["l4-fn-pub"]]
    },
    {
        "id": "l4-fn-pub",
        "type": "function",
        "z": "tab-l4",
        "name": "สร้าง Payload MQTT",
        "func": "// สร้างข้อมูล sensor จำลอง\nvar t = Date.now();\nvar temp = parseFloat((25 + Math.random() * 10).toFixed(1));\nvar humid = parseFloat((50 + Math.random() * 30).toFixed(1));\n\nmsg.payload = JSON.stringify({\n    device_id:   \"MC-01\",\n    timestamp:   new Date().toISOString(),\n    temperature: temp,\n    humidity:    humid,\n    status:      temp > 32 ? \"ALERT\" : \"NORMAL\"\n});\n\n// topic ใช้จาก msg.topic ที่ inject กำหนด\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 130,
        "wires": [["l4-mqtt-out", "l4-dbg-pub"]]
    },
    {
        "id": "l4-mqtt-out",
        "type": "mqtt out",
        "z": "tab-l4",
        "name": "Publish → factory/sensor/mc01",
        "topic": "factory/sensor/mc01",
        "qos": "0",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "l4-mqtt-broker",
        "x": 680,
        "y": 110,
        "wires": []
    },
    {
        "id": "l4-dbg-pub",
        "type": "debug",
        "z": "tab-l4",
        "name": "ยืนยัน: ส่งข้อมูลแล้ว",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 680,
        "y": 160,
        "wires": []
    },

    {
        "id": "l4-cmt-sub",
        "type": "comment",
        "z": "tab-l4",
        "name": "── SUBSCRIBER: รับข้อมูลที่ส่งมา ──",
        "info": "",
        "x": 190,
        "y": 280,
        "wires": []
    },
    {
        "id": "l4-mqtt-in",
        "type": "mqtt in",
        "z": "tab-l4",
        "name": "Subscribe: factory/sensor/#",
        "topic": "factory/sensor/#",
        "qos": "0",
        "datatype": "auto",
        "broker": "l4-mqtt-broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 200,
        "y": 340,
        "wires": [["l4-fn-sub"]]
    },
    {
        "id": "l4-fn-sub",
        "type": "function",
        "z": "tab-l4",
        "name": "แปลง JSON + เพิ่ม received_at",
        "func": "// MQTT payload อาจมาเป็น string หรือ object\nvar data = (typeof msg.payload === 'string')\n    ? JSON.parse(msg.payload)\n    : msg.payload;\n\n// เพิ่มเวลาที่รับ\ndata.received_at = new Date().toISOString();\ndata.mqtt_topic  = msg.topic;\n\nmsg.payload = data;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 340,
        "wires": [["l4-dbg-sub"]]
    },
    {
        "id": "l4-dbg-sub",
        "type": "debug",
        "z": "tab-l4",
        "name": "รับข้อมูลจาก MQTT",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 720,
        "y": 340,
        "wires": []
    },

    {
        "id": "l4-cmt-wildcard",
        "type": "comment",
        "z": "tab-l4",
        "name": "── Wildcard Topics: # (ทุก topic), + (หนึ่ง level) ──",
        "info": "ตัวอย่าง wildcard:\n  factory/# = รับทุก topic ที่ขึ้นต้นด้วย factory/\n  factory/+/mc01 = factory/sensor/mc01, factory/alarm/mc01\n  +/sensor/# = ทุก prefix, ตามด้วย sensor/ แล้วอะไรก็ได้",
        "x": 220,
        "y": 460,
        "wires": []
    },
    {
        "id": "l4-inj-alarm",
        "type": "inject",
        "z": "tab-l4",
        "name": "ส่ง Alarm Message",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "factory/alarm/mc01",
        "payload": "{\"type\":\"OVERHEAT\",\"value\":42.5,\"unit\":\"C\",\"severity\":\"HIGH\"}",
        "payloadType": "json",
        "x": 180,
        "y": 520,
        "wires": [["l4-mqtt-out-alarm"]]
    },
    {
        "id": "l4-mqtt-out-alarm",
        "type": "mqtt out",
        "z": "tab-l4",
        "name": "Publish → factory/alarm/mc01",
        "topic": "factory/alarm/mc01",
        "qos": "1",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "l4-mqtt-broker",
        "x": 460,
        "y": 520,
        "wires": []
    }
]
