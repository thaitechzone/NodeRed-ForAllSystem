[{"id":"bb01ee147a7ae45f","type":"tab","label":"L6: Modbus PLC Simulator","disabled":false,"info":"บทเรียนที่ 6: Modbus TCP + PLC Simulator\nจำลองข้อมูล P, V, I, Hz จาก PLC Mitsubishi\nส่งผ่าน MQTT และแสดงบน Dashboard\n\nPackages ที่ต้องติดตั้ง (Manage Palette):\n1. node-red-dashboard\n2. node-red-contrib-modbus  ← สำหรับส่วน Modbus TCP จริง\n\nส่วน A: PLC Simulator (ทำงานได้ทันที ไม่ต้องมี PLC จริง)\nส่วน B: Dashboard แสดงผล\nส่วน C: Modbus TCP Client (ต้องมี PLC หรือ Modbus Simulator)"},{"id":"e8ff1bb2e54c6727","type":"comment","z":"bb01ee147a7ae45f","name":"── ส่วน A: PLC Data Simulator (ทำงานได้เลย ไม่ต้องมี PLC จริง) ──","info":"","x":290,"y":40,"wires":[]},{"id":"de264975c32bb6b5","type":"inject","z":"bb01ee147a7ae45f","name":"Tick ทุก 5 วิ","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"5","crontab":"","once":true,"onceDelay":0.5,"topic":"plc/mc01","payload":"","payloadType":"date","x":150,"y":100,"wires":[["a5680173130273cd"]]},{"id":"a5680173130273cd","type":"function","z":"bb01ee147a7ae45f","name":"PLC Simulator (MC-01)","func":"// จำลองข้อมูล 3-phase power meter จาก Mitsubishi PLC\nvar t = Date.now() / 1000;\nvar mode = flow.get('plc_mode') || 'NORMAL';\n\n// sine wave สร้างโหลดที่ขึ้นลงตามเวลา (รอบ 2 นาที)\nvar loadFactor = (Math.sin(t * Math.PI / 60) + 1) / 2;  // 0.0 - 1.0\n\n// กำลังไฟฟ้า ตามโหมด\nvar P_kw, pf;\nif (mode === 'ECO') {\n    P_kw = 2.0 + loadFactor * 1.5;  // 2.0-3.5 kW\n    pf = 0.82 + loadFactor * 0.1;\n} else {\n    P_kw = 5.0 + loadFactor * 4.0;  // 5.0-9.0 kW\n    pf = 0.88 + loadFactor * 0.09;\n}\n\n// คำนวณค่าไฟฟ้า\nvar V_rms = 220 + Math.sin(t * 0.1) * 2;\nvar S_kva = P_kw / pf;\nvar I_A = (S_kva * 1000) / (V_rms * Math.sqrt(3));\nvar Hz = 50.0 + Math.sin(t * 0.05) * 0.1;\nvar Q_kvar = S_kva * Math.sqrt(1 - pf * pf);\n\n// spike สุ่ม 5%\nif (Math.random() < 0.05) I_A *= 1.3;\n\nmsg.payload = {\n    timestamp: new Date().toISOString(),\n    device_id: \"MC-01\",\n    mode: mode,\n    P_kw: parseFloat(P_kw.toFixed(3)),\n    V_rms: parseFloat(V_rms.toFixed(1)),\n    I_A: parseFloat(I_A.toFixed(2)),\n    Hz: parseFloat(Hz.toFixed(2)),\n    registers: {\n        D0_power_x10: Math.round(P_kw * 10),\n        D1_volt_x10: Math.round(V_rms * 10),\n        D2_amp_x100: Math.round(I_A * 100),\n        D3_hz_x100: Math.round(Hz * 100)\n    }\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"flow.set('plc_mode', 'NORMAL');","finalize":"","libs":[],"x":390,"y":100,"wires":[["51b6d7ba8c98ec6d","2e43c50a0c7d1695"]]},{"id":"51b6d7ba8c98ec6d","type":"mqtt out","z":"bb01ee147a7ae45f","name":"Publish → plc/mc01/data","topic":"plc/mc01/data","qos":"0","retain":"false","respTopic":"","contentType":"","userProps":"","correl":"","expiry":"","broker":"l6-mqtt-broker","x":670,"y":80,"wires":[]},{"id":"2e43c50a0c7d1695","type":"debug","z":"bb01ee147a7ae45f","name":"Raw PLC Data","active":true,"tosidebar":true,"console":false,"tostatus":true,"complete":"payload","targetType":"msg","statusVal":"payload","statusType":"auto","x":660,"y":130,"wires":[]},{"id":"4c13b54167cffe81","type":"comment","z":"bb01ee147a7ae45f","name":"── Mode Control: NORMAL / ECO ──","info":"","x":200,"y":230,"wires":[]},{"id":"f78265909f7b1d2d","type":"inject","z":"bb01ee147a7ae45f","name":"NORMAL Mode","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"plc/mode","payload":"NORMAL","payloadType":"str","x":180,"y":290,"wires":[["df67aa03c8fc3176"]]},{"id":"a23f32ea0bd3af74","type":"inject","z":"bb01ee147a7ae45f","name":"ECO Mode","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"plc/mode","payload":"ECO","payloadType":"str","x":180,"y":350,"wires":[["df67aa03c8fc3176"]]},{"id":"df67aa03c8fc3176","type":"function","z":"bb01ee147a7ae45f","name":"เปลี่ยน Mode","func":"var mode = msg.payload;\nflow.set('plc_mode', mode);\nnode.status({\n    fill:  mode === 'ECO' ? 'green' : 'blue',\n    shape: 'dot',\n    text:  'Mode: ' + mode\n});\nreturn null;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":710,"y":360,"wires":[[]]},{"id":"6307eebeda62a8eb","type":"comment","z":"bb01ee147a7ae45f","name":"── ส่วน B: Dashboard — รับข้อมูลจาก MQTT → แสดง Gauge + Chart ──","info":"","x":330,"y":460,"wires":[]},{"id":"972dca71bdc61432","type":"mqtt in","z":"bb01ee147a7ae45f","name":"Subscribe: plc/mc01/data","topic":"plc/mc01/data","qos":"0","datatype":"auto","broker":"l6-mqtt-broker","nl":false,"rap":true,"rh":0,"inputs":0,"x":200,"y":540,"wires":[["60d1c64fd63ddfef"]]},{"id":"60d1c64fd63ddfef","type":"function","z":"bb01ee147a7ae45f","name":"แจกข้อมูลให้ Widget","func":"var d = (typeof msg.payload === 'string')\n    ? JSON.parse(msg.payload)\n    : msg.payload;\n\n// ส่งแยกแต่ละค่าไปยัง widget\nnode.send([\n    { payload: d.P_kw,    topic: \"power\" },\n    { payload: d.V_rms,   topic: \"voltage\" },\n    { payload: d.I_A,     topic: \"current\" },\n    { payload: d.Hz,      topic: \"frequency\" },\n    { payload: d.P_kw,    topic: \"chart\" }\n   \n]);\nreturn null;","outputs":6,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":450,"y":540,"wires":[["d6ef60908d31d9fa"],["9f456b021f84af4c"],["d337a4a34ffe3dc4"],["b0d72969cc08afc0"],["e8cb4fb7026669bc"],["7806863f72c0703f"]]},{"id":"d6ef60908d31d9fa","type":"ui_gauge","z":"bb01ee147a7ae45f","name":"Active Power","group":"8355b1ac4a41dc9f","order":1,"width":3,"height":3,"gtype":"gage","title":"Active Power","label":"kW","format":"{{value}}","min":"0","max":"10","colors":["#00b500","#e6e600","#ca3838"],"seg1":"5","seg2":"8","diff":false,"className":"","x":730,"y":480,"wires":[]},{"id":"9f456b021f84af4c","type":"ui_gauge","z":"bb01ee147a7ae45f","name":"Voltage","group":"8355b1ac4a41dc9f","order":2,"width":3,"height":3,"gtype":"gage","title":"Voltage (L-N)","label":"V","format":"{{value}}","min":"190","max":"250","colors":["#ca3838","#00b500","#ca3838"],"seg1":"207","seg2":"233","diff":false,"className":"","x":730,"y":530,"wires":[]},{"id":"d337a4a34ffe3dc4","type":"ui_gauge","z":"bb01ee147a7ae45f","name":"Current","group":"8355b1ac4a41dc9f","order":3,"width":3,"height":3,"gtype":"gage","title":"Current","label":"A","format":"{{value}}","min":"0","max":"30","colors":["#00b500","#e6e600","#ca3838"],"seg1":"15","seg2":"22","diff":false,"className":"","x":730,"y":580,"wires":[]},{"id":"b0d72969cc08afc0","type":"ui_gauge","z":"bb01ee147a7ae45f","name":"Frequency","group":"8355b1ac4a41dc9f","order":4,"width":3,"height":3,"gtype":"gage","title":"Frequency","label":"Hz","format":"{{value}}","min":"48","max":"52","colors":["#ca3838","#00b500","#ca3838"],"seg1":"49.5","seg2":"50.5","diff":false,"className":"","x":730,"y":630,"wires":[]},{"id":"7806863f72c0703f","type":"ui_gauge","z":"bb01ee147a7ae45f","name":"Power Factor","group":"8355b1ac4a41dc9f","order":5,"width":4,"height":2,"gtype":"donut","title":"Power Factor","label":"PF","format":"{{value}}","min":"0","max":"1","colors":["#ca3838","#e6e600","#00b500"],"seg1":"0.8","seg2":"0.95","diff":false,"className":"","x":730,"y":700,"wires":[]},{"id":"e8cb4fb7026669bc","type":"ui_chart","z":"bb01ee147a7ae45f","name":"Power Trend","group":"8355b1ac4a41dc9f","order":1,"width":"0","height":"0","label":"Active Power (kW)","chartType":"line","legend":"false","xformat":"HH:mm:ss","interpolate":"linear","nodata":"กำลังรอข้อมูล...","dot":false,"ymin":"0","ymax":"10","removeOlder":5,"removeOlderPoints":"300","removeOlderUnit":"60","cutout":0,"useOneColor":false,"useUTC":false,"colors":["#e74c3c","#000000","#000000","#000000","#000000","#000000","#000000","#000000","#000000"],"outputs":1,"useDifferentColor":false,"className":"","x":730,"y":780,"wires":[[]]},{"id":"25644aa4fab497cf","type":"ui_button","z":"bb01ee147a7ae45f","name":"NORMAL Mode","group":"4ec398373e14b5f5","order":1,"width":3,"height":1,"passthru":false,"label":"NORMAL Mode","tooltip":"โหลดสูง 5-9 kW","color":"white","bgcolor":"#2980b9","className":"","icon":"","payload":"NORMAL","payloadType":"str","topic":"plc/mode","topicType":"str","x":480,"y":280,"wires":[["df67aa03c8fc3176"]]},{"id":"8947d79c499b3994","type":"ui_button","z":"bb01ee147a7ae45f","name":"ECO Mode","group":"4ec398373e14b5f5","order":2,"width":3,"height":1,"passthru":false,"label":"ECO Mode","tooltip":"ประหยัดไฟ 2-3.5 kW","color":"white","bgcolor":"#27ae60","className":"","icon":"","payload":"ECO","payloadType":"str","topic":"plc/mode","topicType":"str","x":470,"y":240,"wires":[["df67aa03c8fc3176"]]},{"id":"3cf90997f9fd1fa2","type":"comment","z":"bb01ee147a7ae45f","name":"── ส่วน C: Modbus TCP Client (ต้องติดตั้ง node-red-contrib-modbus และมี PLC จริง) ──","info":"วิธีติดตั้ง:\n1. Menu ≡ → Manage Palette → Install\n2. ค้นหา: node-red-contrib-modbus\n3. Install แล้ว Restart\n\nRegister Map (Mitsubishi D-Register):\n  D0 = Active Power   [W * 10]   e.g. 35000 = 3500.0 W\n  D1 = Voltage        [V * 10]   e.g.  2200 = 220.0 V\n  D2 = Current        [A * 100]  e.g.  1590 = 15.90 A\n  D3 = Frequency      [Hz* 100]  e.g.  5000 = 50.00 Hz\n\nFCODE 3 = Read Holding Registers (FC03)","x":380,"y":920,"wires":[]},{"id":"a17d8cb710e0eae0","type":"modbus-read","z":"bb01ee147a7ae45f","name":"อ่าน D0-D3 (P, V, I, Hz)","topic":"modbus/plc","showStatusActivities":true,"logIOActivities":false,"showErrors":true,"showWarnings":true,"unitid":"1","dataType":"HoldingRegister","adr":"0","quantity":"4","rate":"1","rateUnit":"s","delayOnStart":false,"enableDeformedMessages":false,"startDelayTime":"","server":"l6-modbus-client","useIOFile":false,"ioFile":"","useIOForPayload":false,"emptyMsgOnFail":false,"x":200,"y":1000,"wires":[["cb28595008ea2bdd"],["dd901f456e37e214"]]},{"id":"cb28595008ea2bdd","type":"function","z":"bb01ee147a7ae45f","name":"แปลงค่า Modbus Registers","func":"// msg.payload.data = array ของ register uint16\nvar regs = msg.payload.data;\nif (!regs || regs.length < 4) {\n    node.error(\"ไม่ได้รับข้อมูล register\");\n    return null;\n}\n\n// แปลงตาม scaling factor ของ PLC\nvar P_kw  = regs[0] / 10000;   // D0: W*10  → kW\nvar V_rms = regs[1] / 10;      // D1: V*10  → V\nvar I_A   = regs[2] / 100;     // D2: A*100 → A\nvar Hz    = regs[3] / 100;     // D3: Hz*100 → Hz\n\nmsg.payload = {\n    timestamp: new Date().toISOString(),\n    device_id: \"MC-01\",\n    mode:      \"MODBUS\",\n    P_kw:      P_kw,\n    V_rms:     V_rms,\n    I_A:       I_A,\n    Hz:        Hz,\n    raw_regs:  regs\n};\n\n// ส่งไปยัง MQTT topic เดิม เพื่อให้ Dashboard แสดงผล\nmsg.topic = \"plc/mc01/data\";\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":480,"y":980,"wires":[["eb08026b231a52a4"]]},{"id":"eb08026b231a52a4","type":"mqtt out","z":"bb01ee147a7ae45f","name":"Publish → plc/mc01/data","topic":"plc/mc01/data","qos":"0","retain":"false","respTopic":"","contentType":"","userProps":"","correl":"","expiry":"","broker":"l6-mqtt-broker","x":750,"y":980,"wires":[]},{"id":"dd901f456e37e214","type":"debug","z":"bb01ee147a7ae45f","name":"Modbus Error","active":false,"tosidebar":true,"console":false,"tostatus":true,"complete":"payload","targetType":"msg","statusVal":"","statusType":"auto","x":460,"y":1080,"wires":[]},{"id":"l6-mqtt-broker","type":"mqtt-broker","name":"Mosquitto Local","broker":"mosquitto","port":"1883","clientid":"nodered-lesson6","autoConnect":true,"usetls":false,"protocolVersion":"4","keepalive":"60","cleansession":true,"autoUnsubscribe":true,"birthTopic":"","birthQos":"0","birthPayload":"","birthMsg":{},"closeTopic":"","closeQos":"0","closePayload":"","closeMsg":{},"willTopic":"","willQos":"0","willPayload":"","willMsg":{},"userProps":"","sessionExpiry":""},{"id":"8355b1ac4a41dc9f","type":"ui_group","name":"Group 1","tab":"bcd5890caaba5bae","order":1,"disp":true,"width":6},{"id":"4ec398373e14b5f5","type":"ui_group","name":"Group 2","tab":"bcd5890caaba5bae","order":2,"disp":true,"width":6},{"id":"l6-modbus-client","type":"modbus-client","name":"Mitsubishi PLC (192.168.1.10:502)","clienttype":"tcp","bufferCommands":true,"stateLogEnabled":false,"queueLogEnabled":false,"failureLogEnabled":true,"tcpHost":"127.0.0.1","tcpPort":"502","tcpType":"DEFAULT","serialPort":"/dev/ttyUSB","serialType":"RTU-BUFFERED","serialBaudrate":"9600","serialDatabits":"8","serialStopbits":"1","serialParity":"none","serialConnectionDelay":"100","serialAsciiResponseStartDelimiter":"","unit_id":1,"commandDelay":1,"clientTimeout":1000,"reconnectOnTimeout":true,"reconnectTimeout":2000,"parallelUnitIdsAllowed":true,"showErrors":false,"showWarnings":true,"showLogs":true},{"id":"bcd5890caaba5bae","type":"ui_tab","name":"PLC Monitor","icon":"memory","order":20,"disabled":false,"hidden":false},{"id":"31b3f681d22dd8e4","type":"global-config","env":[],"modules":{"node-red-dashboard":"3.6.6","node-red-contrib-modbus":"5.45.2"}}]