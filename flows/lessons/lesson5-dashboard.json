    {
        "id": "l5-cmt-sim",
        "type": "comment",
        "z": "tab-l5",
        "name": "── Sensor Simulator: inject ทุก 2 วิ → function สร้างข้อมูลจำลอง ──",
        "info": "",
        "x": 280,
        "y": 40,
        "wires": []
    },
    {
        "id": "l5-inj-sim",
        "type": "inject",
        "z": "tab-l5",
        "name": "Tick ทุก 2 วิ",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "2",
        "crontab": "",
        "once": true,
        "onceDelay": 0.5,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 100,
        "wires": [["l5-fn-sim"]]
    },
    {
        "id": "l5-fn-sim",
        "type": "function",
        "z": "tab-l5",
        "name": "จำลองข้อมูล Sensor",
        "func": "// จำลองข้อมูล environment sensor\nvar t = Date.now() / 1000;\n\n// sine wave ให้ค่าขึ้นลงตามเวลา\nvar temp    = parseFloat((27 + Math.sin(t * 0.05) * 5).toFixed(1));      // 22-32°C\nvar humid   = parseFloat((60 + Math.cos(t * 0.03) * 15).toFixed(1));     // 45-75%\nvar light   = parseFloat((500 + Math.sin(t * 0.1) * 300).toFixed(0));    // 200-800 lux\nvar sound   = parseFloat((40 + Math.random() * 20).toFixed(1));           // 40-60 dB\n\nflow.set('temp', temp);\nflow.set('humid', humid);\n\nmsg.payload = { temp, humid, light, sound, ts: new Date().toISOString() };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 100,
        "wires": [["l5-split"]]
    },
    {
        "id": "l5-split",
        "type": "function",
        "z": "tab-l5",
        "name": "แยกส่งแต่ละ Widget",
        "func": "var d = msg.payload;\n\n// ส่งแยกแต่ละค่าไปยัง widget ที่ต้องการ\nnode.send([\n    { payload: d.temp,  topic: \"temperature\" },\n    { payload: d.humid, topic: \"humidity\" },\n    { payload: d.light, topic: \"light\" },\n    { payload: d.sound, topic: \"sound\" }\n]);\nreturn null;",
        "outputs": 4,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 100,
        "wires": [
            ["l5-gauge-temp", "l5-chart-temp"],
            ["l5-gauge-humid"],
            ["l5-gauge-light"],
            ["l5-text-sound"]
        ]
    },

