    {
        "id": "l6-fn-parse",
        "type": "function",
        "z": "tab-l6",
        "name": "แจกข้อมูลให้ Widget",
        "func": "var d = (typeof msg.payload === 'string')\n    ? JSON.parse(msg.payload)\n    : msg.payload;\n\n// ส่งแยกแต่ละค่าไปยัง widget\nnode.send([\n    { payload: d.P_kw,    topic: \"power\" },\n    { payload: d.V_rms,   topic: \"voltage\" },\n    { payload: d.I_A,     topic: \"current\" },\n    { payload: d.Hz,      topic: \"frequency\" },\n    { payload: d.P_kw,    topic: \"chart\" },\n    { payload: d.pf,      topic: \"pf\" }\n]);\nreturn null;",
        "outputs": 6,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 500,
