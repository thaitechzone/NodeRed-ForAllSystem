    {
        "id": "l6-fn-modbus-parse",
        "type": "function",
        "z": "tab-l6",
        "name": "แปลงค่า Modbus Registers",
        "func": "// msg.payload.data = array ของ register uint16\nvar regs = msg.payload.data;\nif (!regs || regs.length < 4) {\n    node.error(\"ไม่ได้รับข้อมูล register\");\n    return null;\n}\n\n// แปลงตาม scaling factor ของ PLC\nvar P_kw  = regs[0] / 10;      // D0: kW*10 → kW\nvar V_rms = regs[1] / 10;      // D1: V*10  → V\nvar I_A   = regs[2] / 100;     // D2: A*100 → A\nvar Hz    = regs[3] / 100;     // D3: Hz*100 → Hz\n\nmsg.payload = {\n    timestamp: new Date().toISOString(),\n    device_id: \"MC-01\",\n    mode:      \"MODBUS\",\n    P_kw:      P_kw,\n    V_rms:     V_rms,\n    I_A:       I_A,\n    Hz:        Hz,\n    raw_regs:  regs\n};\n\n// ส่งไปยัง MQTT topic เดิม เพื่อให้ Dashboard แสดงผล\nmsg.topic = \"plc/mc01/data\";\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 1020,
        "wires": [["l6-mqtt-out-modbus"]]
    },
