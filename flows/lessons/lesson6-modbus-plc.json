    {
        "id": "l6-fn-plc",
        "type": "function",
        "z": "tab-l6",
        "name": "PLC Simulator (MC-01)",
        "func": "// จำลองข้อมูล 3-phase power meter จาก Mitsubishi PLC\nvar t = Date.now() / 1000;\nvar mode = flow.get('plc_mode') || 'NORMAL';\n\n// sine wave สร้างโหลดที่ขึ้นลงตามเวลา (รอบ 2 นาที)\nvar loadFactor = (Math.sin(t * Math.PI / 60) + 1) / 2;  // 0.0 - 1.0\n\n// กำลังไฟฟ้า ตามโหมด\nvar P_kw, pf;\nif (mode === 'ECO') {\n    P_kw = 2.0 + loadFactor * 1.5;  // 2.0-3.5 kW\n    pf   = 0.82 + loadFactor * 0.1;\n} else {\n    P_kw = 5.0 + loadFactor * 4.0;  // 5.0-9.0 kW\n    pf   = 0.88 + loadFactor * 0.09;\n}\n\n// คำนวณค่าไฟฟ้า\nvar V_rms = 220 + Math.sin(t * 0.1) * 2;              // ~220V ± 2V\nvar S_kva = P_kw / pf;\nvar I_A   = (S_kva * 1000) / (V_rms * Math.sqrt(3)); // กระแส 3-phase\nvar Hz    = 50.0 + Math.sin(t * 0.05) * 0.1;          // ~50Hz\nvar Q_kvar = S_kva * Math.sqrt(1 - pf * pf);\n\n// spike สุ่ม 5%\nif (Math.random() < 0.05) I_A *= 1.3;\n\nmsg.payload = {\n    timestamp: new Date().toISOString(),\n    device_id: \"MC-01\",\n    mode:      mode,\n    P_kw:      parseFloat(P_kw.toFixed(3)),\n    Q_kvar:    parseFloat(Q_kvar.toFixed(3)),\n    S_kva:     parseFloat(S_kva.toFixed(3)),\n    V_rms:     parseFloat(V_rms.toFixed(1)),\n    I_A:       parseFloat(I_A.toFixed(2)),\n    Hz:        parseFloat(Hz.toFixed(2)),\n    pf:        parseFloat(pf.toFixed(3)),\n    load_pct:  parseFloat((loadFactor * 100).toFixed(1)),\n    // Modbus register values (เหมือนใน PLC จริง)\n    // D0=P*10, D1=V*10, D2=I*100, D3=Hz*100\n    registers: {\n        D0_power_x10:  Math.round(P_kw * 10),\n        D1_volt_x10:   Math.round(V_rms * 10),\n        D2_amp_x100:   Math.round(I_A * 100),\n        D3_hz_x100:    Math.round(Hz * 100)\n    }\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "flow.set('plc_mode', 'NORMAL');",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 100,
        "wires": [["l6-mqtt-out-plc", "l6-dbg-plc"]]
    },
