        "label": "L3: HTTP Request",
        "disabled": false,
        "info": "บทเรียนที่ 3: HTTP Request Node\nดึงข้อมูลจาก REST API ผ่าน HTTP GET\nส่วน A = URL คงที่, ส่วน B = URL แบบ dynamic"
    },

    {
        "id": "l3-cmt-a",
        "type": "comment",
        "z": "tab-l3",
        "name": "── ส่วน A: GET URL คงที่ (jsonplaceholder API) ──",
        "info": "",
        "x": 230,
        "y": 40,
        "wires": []
    },
    {
        "id": "l3a-inj",
        "type": "inject",
        "z": "tab-l3",
        "name": "ดึง Todo #1",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "api/get",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 100,
        "wires": [["l3a-http"]]
    },
    {
        "id": "l3a-http",
        "type": "http request",
        "z": "tab-l3",
        "name": "GET /todos/1",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://jsonplaceholder.typicode.com/todos/1",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "senderr": false,
        "x": 340,
        "y": 100,
        "wires": [["l3a-fn"]]
    },
    {
        "id": "l3a-fn",
        "type": "function",
        "z": "tab-l3",
        "name": "แยกข้อมูลที่ต้องการ",
        "func": "var data = msg.payload;\n\n// HTTP status code\nvar httpStatus = msg.statusCode;\n\nmsg.payload = {\n    http_status:  httpStatus,\n    todo_id:      data.id,\n    user_id:      data.userId,\n    title:        data.title,\n    completed:    data.completed\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 100,
        "wires": [["l3a-dbg"]]
    },
    {
        "id": "l3a-dbg",
        "type": "debug",
        "z": "tab-l3",
        "name": "Todo Data",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 730,
        "y": 100,
        "wires": []
    },

    {
        "id": "l3-cmt-b",
