    },
    {
        "id": "l3b-fn-url",
        "type": "function",
        "z": "tab-l3",
        "name": "สร้าง URL จาก ID",
        "func": "var userId = msg.payload;\n\n// สร้าง URL โดยนำ ID ไปต่อท้าย\nmsg.url = \"https://jsonplaceholder.typicode.com/users/\" + userId;\n\n// เก็บ ID ไว้ใน msg เพื่อใช้ต่อ\nmsg.userId = userId;\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 310,
        "wires": [["l3b-http"]]
    },
    {
        "id": "l3b-http",
        "type": "http request",
        "z": "tab-l3",
        "name": "GET User (URL จาก msg.url)",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "senderr": false,
        "x": 570,
        "y": 310,
        "wires": [["l3b-fn-parse"]]
    },
    {
        "id": "l3b-fn-parse",
        "type": "function",
        "z": "tab-l3",
        "name": "แสดงชื่อและที่อยู่",
        "func": "var u = msg.payload;\n\nmsg.payload = {\n    id:       u.id,\n    name:     u.name,\n    email:    u.email,\n    phone:    u.phone,\n    city:     u.address ? u.address.city : \"N/A\",\n    company:  u.company ? u.company.name : \"N/A\"\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 310,
        "wires": [["l3b-dbg"]]
    },
