    {
        "id": "l2d-inj",
        "type": "inject",
        "z": "tab-l2",
        "name": "เริ่มส่งข้อมูล 3 ชุด",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "multi/trigger",
        "payload": "start",
        "payloadType": "str",
        "x": 160,
        "y": 600,
        "wires": [["l2d-fn"]]
    },
    {
        "id": "l2d-fn",
        "type": "function",
        "z": "tab-l2",
        "name": "ส่ง 3 message ทีเดียว",
        "func": "// ส่ง message หลายอัน ด้วย node.send()\nvar readings = [\n    { sensor: \"A\", value: 23.1, unit: \"°C\" },\n    { sensor: \"B\", value: 67.5, unit: \"%RH\" },\n    { sensor: \"C\", value: 220.4, unit: \"V\" }\n];\n\nreadings.forEach(function(r) {\n    node.send({ payload: r, topic: \"multi/\" + r.sensor });\n});\n\n// return null เพื่อไม่ส่ง message เพิ่ม\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 600,
        "wires": [["l2d-dbg"]]
    },
