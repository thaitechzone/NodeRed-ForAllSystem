    {
        "id": "l2b-inj",
        "type": "inject",
        "z": "tab-l2",
        "name": "ข้อมูล Sensor (JSON)",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "sensor/raw",
        "payload": "{\"temperature\":28.5,\"humidity\":65,\"voltage\":220.3,\"current\":3.7}",
        "payloadType": "json",
        "x": 160,
        "y": 260,
        "wires": [["l2b-fn"]]
    },
    {
        "id": "l2b-fn",
        "type": "function",
        "z": "tab-l2",
        "name": "วิเคราะห์ Sensor",
        "func": "var d = msg.payload;\n\n// คำนวณ Power จาก V * I\nvar power_w = d.voltage * d.current;\n\n// เพิ่มฟิลด์ใหม่และ timestamp\nmsg.payload = {\n    temperature_c:  d.temperature,\n    temperature_f:  parseFloat((d.temperature * 9/5 + 32).toFixed(1)),\n    humidity_pct:   d.humidity,\n    voltage_v:      d.voltage,\n    current_a:      d.current,\n    power_w:        parseFloat(power_w.toFixed(2)),\n    power_kw:       parseFloat((power_w / 1000).toFixed(4)),\n    timestamp:      new Date().toISOString()\n};\n\n// เปลี่ยน topic\nmsg.topic = \"sensor/processed\";\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 260,
        "wires": [["l2b-dbg"]]
    },
    {
        "id": "l2b-dbg",
        "type": "debug",
        "z": "tab-l2",
        "name": "ข้อมูลที่แปลงแล้ว",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 600,
        "y": 260,
        "wires": []
    },

    {
