    {
        "id": "l2c-inj",
        "type": "inject",
        "z": "tab-l2",
        "name": "ป้อนอุณหภูมิ 35 °C",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "temp/check",
        "payload": "35",
        "payloadType": "num",
        "x": 160,
        "y": 420,
        "wires": [["l2c-fn"]]
    },
    {
        "id": "l2c-fn",
        "type": "function",
        "z": "tab-l2",
        "name": "ตรวจสอบอุณหภูมิ (2 outputs)",
        "func": "var temp = msg.payload;\n\n// output 1 = ปกติ (temp <= 30)\n// output 2 = เตือน  (temp > 30)\nif (temp <= 30) {\n    msg.payload = { status: \"ปกติ\", temp: temp, color: \"green\" };\n    return [msg, null];\n} else {\n    msg.payload = { status: \"เตือน! ร้อนเกิน\", temp: temp, color: \"red\" };\n    return [null, msg];\n}",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 420,
        "wires": [["l2c-dbg-ok"], ["l2c-dbg-warn"]]
    },
    {
        "id": "l2c-dbg-ok",
        "type": "debug",
        "z": "tab-l2",
        "name": "✅ ปกติ",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
