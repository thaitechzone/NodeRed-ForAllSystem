        "info": "",
        "x": 210,
        "y": 40,
        "wires": []
    },
    {
        "id": "l2a-inj",
        "type": "inject",
        "z": "tab-l2",
        "name": "ป้อนตัวเลข 100",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "math/input",
        "payload": "100",
        "payloadType": "num",
        "x": 160,
        "y": 100,
        "wires": [["l2a-fn"]]
    },
    {
        "id": "l2a-fn",
        "type": "function",
        "z": "tab-l2",
        "name": "คำนวณค่าต่างๆ",
        "func": "var n = msg.payload;\n\n// ประมวลผลหลายอย่างพร้อมกัน\nmsg.payload = {\n    input:    n,\n    doubled:  n * 2,\n    squared:  n * n,\n    sqrt:     parseFloat(Math.sqrt(n).toFixed(4)),\n    isEven:   (n % 2 === 0),\n    percent:  (n / 1000 * 100).toFixed(1) + \"%\"\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 100,
        "wires": [["l2a-dbg"]]
    },
    {
        "id": "l2a-dbg",
        "type": "debug",
        "z": "tab-l2",
        "name": "ผลคำนวณ",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 580,
        "y": 100,
        "wires": []
    },

    {
        "id": "l2-cmt-b",
        "type": "comment",
