  {
    "id": "c1ce27e5909b4f61",
    "type": "function",
    "z": "d4f8727bf5a34f01",
    "name": "Prepare n8n webhook body",
    "func": "msg.headers = {\n    'Content-Type': 'application/json',\n    'ngrok-skip-browser-warning': 'true'\n};\n\nmsg.payload = {\n    event: 'machine_energy_telemetry',\n    source: 'node-red',\n    topic: msg.topic || 'smartfactory/MC-01/energy/telemetry',\n    data: msg.payload\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 710,
