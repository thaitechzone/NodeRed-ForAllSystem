  {
    "id": "fn_ui_prep_001",
    "type": "function",
    "z": "d4f8727bf5a34f01",
    "name": "Prepare UI gauges & chart",
    "func": "const d = msg.payload;\nconst maxCurrent = Math.max(d.current_a.l1, d.current_a.l2, d.current_a.l3);\n\nconst msgPower   = { payload: d.active_power_kw };\nconst msgPF      = { payload: Math.round(d.power_factor * 100) };\nconst msgLoad    = { payload: d.load_pct };\nconst msgChart   = { payload: d.active_power_kw, topic: 'Power kW' };\nconst msgCurrent = { payload: Number(maxCurrent.toFixed(2)) };\n\nreturn [msgPower, msgPF, msgLoad, msgChart, msgCurrent];",
    "outputs": 5,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 200,
    "wires": [
      ["ui_gauge_pwr_001"],
