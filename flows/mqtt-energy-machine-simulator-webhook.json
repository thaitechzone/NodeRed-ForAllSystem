  {
    "id": "ba9e9af4c7744531",
    "type": "function",
    "z": "d4f8727bf5a34f01",
    "name": "Build machine energy payload",
    "func": "const rand = (min, max, digits = 2) => Number((Math.random() * (max - min) + min).toFixed(digits));\n\nconst voltageL1 = rand(219, 232, 1);\nconst voltageL2 = rand(218, 231, 1);\nconst voltageL3 = rand(220, 233, 1);\nconst currentL1 = rand(8.0, 18.0, 2);\nconst currentL2 = rand(7.8, 17.5, 2);\nconst currentL3 = rand(8.2, 18.2, 2);\nconst pf = rand(0.82, 0.98, 3);\nconst frequency = rand(49.8, 50.2, 2);\nconst activePowerKw = rand(4.2, 9.8, 3);\nconst reactivePowerKvar = rand(1.1, 3.4, 3);\nconst apparentPowerKva = Number((activePowerKw / pf).toFixed(3));\nconst energyTodayKwh = rand(120.0, 360.0, 2);\n\nmsg.payload = {\n    machine_id: 'MC-01',\n    ts: new Date().toISOString(),\n    voltage_v: { l1: voltageL1, l2: voltageL2, l3: voltageL3 },\n    current_a: { l1: currentL1, l2: currentL2, l3: currentL3 },\n    frequency_hz: frequency,\n    power_factor: pf,\n    active_power_kw: activePowerKw,\n    reactive_power_kvar: reactivePowerKvar,\n    apparent_power_kva: apparentPowerKva,\n    energy_today_kwh: energyTodayKwh,\n    motor_rpm: Math.round(rand(1450, 1495, 0)),\n    load_pct: rand(42, 88, 1),\n    alarm_overcurrent: currentL1 > 17.5 || currentL2 > 17.5 || currentL3 > 17.5,\n    source: 'node-red-energy-simulator'\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 120,
    "wires": [["ab4a8e8ea87e4f41", "ed9f2bc4d2da4f51", "c1ce27e5909b4f61"]]
  },
