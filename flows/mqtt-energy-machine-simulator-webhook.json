  {
    "id": "c53d1e93af994f21",
    "type": "inject",
    "z": "d4f8727bf5a34f01",
    "name": "Energy telemetry every 5s",
    "props": [
      { "p": "payload" },
      { "p": "topic", "vt": "str" }
    ],
    "repeat": "5",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
    "topic": "smartfactory/MC-01/energy/telemetry",
    "payload": "",
    "payloadType": "date",
    "x": 180,
    "y": 100,
    "wires": [["ba9e9af4c7744531"]]
  },
  {
    "id": "ba9e9af4c7744531",
    "type": "function",
    "z": "d4f8727bf5a34f01",
    "name": "Build machine energy payload",
    "func": "const reducePower = flow.get('reduce_power') || false;\nconst rand = (min, max, digits = 2) => Number((Math.random() * (max - min) + min).toFixed(digits));\n\nconst loadMin   = reducePower ? 25  : 42;\nconst loadMax   = reducePower ? 50  : 88;\nconst powerMin  = reducePower ? 2.0 : 4.2;\nconst powerMax  = reducePower ? 5.0 : 9.8;\nconst curMin    = reducePower ? 4.0 : 8.0;\nconst curMax    = reducePower ? 9.0 : 18.2;\n\nconst voltageL1 = rand(219, 232, 1);\nconst voltageL2 = rand(218, 231, 1);\nconst voltageL3 = rand(220, 233, 1);\nconst currentL1 = rand(curMin, curMax, 2);\nconst currentL2 = rand(curMin, curMax - 0.5, 2);\nconst currentL3 = rand(curMin, curMax + 0.2, 2);\nconst pf = reducePower ? rand(0.92, 0.98, 3) : rand(0.82, 0.98, 3);\nconst frequency = rand(49.8, 50.2, 2);\nconst activePowerKw = rand(powerMin, powerMax, 3);\nconst reactivePowerKvar = rand(1.1, 3.4, 3);\nconst apparentPowerKva = Number((activePowerKw / pf).toFixed(3));\nconst energyTodayKwh = rand(120.0, 360.0, 2);\nconst load_pct = rand(loadMin, loadMax, 1);\n\nmsg.payload = {\n    machine_id: 'MC-01',\n    ts: new Date().toISOString(),\n    voltage_v: { l1: voltageL1, l2: voltageL2, l3: voltageL3 },\n    current_a: { l1: currentL1, l2: currentL2, l3: currentL3 },\n    frequency_hz: frequency,\n    power_factor: pf,\n    active_power_kw: activePowerKw,\n    reactive_power_kvar: reactivePowerKvar,\n    apparent_power_kva: apparentPowerKva,\n    energy_today_kwh: energyTodayKwh,\n    motor_rpm: Math.round(rand(reducePower ? 1200 : 1450, reducePower ? 1380 : 1495, 0)),\n    load_pct: load_pct,\n    alarm_overcurrent: currentL1 > 17.5 || currentL2 > 17.5 || currentL3 > 17.5,\n    power_mode: reducePower ? 'ECO' : 'NORMAL',\n    reduce_power_active: reducePower,\n    source: 'node-red-energy-simulator'\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 100,
    "wires": [["ab4a8e8ea87e4f41", "ed9f2bc4d2da4f51", "c1ce27e5909b4f61", "fn_ui_prep_001"]]
  },
