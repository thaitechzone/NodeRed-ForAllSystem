  {
    "id": "fn_store_cmd_001",
    "type": "function",
    "z": "d4f8727bf5a34f01",
    "name": "Store N8N command + prepare UI",
    "func": "const body = msg.payload || {};\nconst reducePower = body.reduce_power === true;\n\nflow.set('reduce_power', reducePower);\nflow.set('last_analysis', body);\n\n// ส่ง msg ตัวเดิม (ต้องรักษา msg.res ไว้เพื่อให้ http response node ทำงานได้)\nmsg.statusCode = 200;\nmsg.payload = { status: 'ok', reduce_power: reducePower, ts: new Date().toISOString() };\n\nconst uiMode      = { payload: reducePower ? '🔴 ECO MODE — ลดการใช้พลังงาน' : '🟢 NORMAL — ทำงานปกติ' };\nconst uiReason    = { payload: body.reason         || '-' };\nconst uiRecommend = { payload: body.recommendation  || '-' };\nconst uiRisk      = { payload: 'Risk: ' + (body.risk_level || 'unknown').toUpperCase() };\n\nreturn [msg, uiMode, uiReason, uiRecommend, uiRisk];",
    "outputs": 5,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 600,
    "wires": [
      ["http_resp_cmd_001"],
      ["ui_text_mode_001"],
      ["ui_text_reason_001"],
      ["ui_text_recommend_001"],
      ["ui_text_risk_001"]
    ]
  },
