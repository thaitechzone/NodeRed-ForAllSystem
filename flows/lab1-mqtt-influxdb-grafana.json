    {
        "id": "fn-format-influx",
        "type": "function",
        "z": "tab-lab1",
        "name": "Format for InfluxDB",
        "func": "var data = msg.payload;\n\n// ── ตรวจสอบข้อมูลที่จำเป็น ──────────────────────────────\nif (data.temperature === undefined || data.humidity === undefined) {\n    node.warn('[Lab1] Missing required fields: temperature or humidity');\n    node.status({fill:'yellow', shape:'ring', text:'missing fields'});\n    return null;\n}\n\n// ── แยก device ID จาก topic หรือ payload ────────────────\nvar topic = msg.topic || '';\nvar deviceId = data.device || topic.split('/')[1] || 'unknown-device';\n\n// ── สร้าง InfluxDB data point ─────────────────────────────\n// format: flat object — measurement name ตั้งใน InfluxDB Out node\n// รองรับทุกเวอร์ชัน node-red-contrib-influxdb\nmsg.payload = {\n    temperature:   parseFloat(data.temperature),\n    humidity:      parseFloat(data.humidity),\n    soil_moisture: parseFloat(data.soil_moisture || 0),\n    relay:         parseInt(data.relay || 0),\n    rssi:          parseInt(data.rssi || 0),\n    device:        deviceId\n};\n\n// ── อัพเดต status บน node ────────────────────────────────\nnode.status({\n    fill: 'green',\n    shape: 'dot',\n    text: deviceId + ' T:' + data.temperature + '°C H:' + data.humidity + '%'\n});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 730,
        "y": 140,
        "wires": [["debug-influx-payload", "influxdb-out-node"]]
    },
