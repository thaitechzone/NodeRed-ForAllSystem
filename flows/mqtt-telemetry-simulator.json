  {
    "id": "a1ce6bded1bd4b31",
    "type": "function",
    "z": "b1f0f2e1a0c34d01",
    "name": "Build telemetry payload",
    "func": "const rand = (min, max, digits = 1) => Number((Math.random() * (max - min) + min).toFixed(digits));\n\nmsg.payload = {\n    device_id: 'NR-SIM-001',\n    ts: new Date().toISOString(),\n    temperature_c: rand(24, 34, 1),\n    humidity_pct: rand(45, 85, 1),\n    heat_index_c: rand(27, 40, 1),\n    soil_moisture_pct: rand(30, 75, 1),\n    pressure_hpa: rand(995, 1015, 1),\n    battery_v: rand(3.65, 4.18, 2),\n    relay_pump: Math.random() > 0.7,\n    relay_fan: Math.random() > 0.5,\n    rssi_dbm: Math.round(rand(-80, -45, 0)),\n    firmware: 'simulator-1.0.0',\n    source: 'node-red-simulator'\n};\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 120,
    "wires": [["fa245230018b4f41", "d13cb8ca79084f51"]]
  },
