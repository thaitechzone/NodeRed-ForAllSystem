      "parameters": {
        "jsCode": "// รับข้อมูลจาก MQTT topic plc/mc01/data\nconst raw = $input.first().json;\nconst d = typeof raw === 'string' ? JSON.parse(raw) : raw;\n\n// ตรวจสอบข้อมูลครบ\nif (!d.P_kw || !d.V_rms) {\n  throw new Error('ข้อมูลไม่ครบ: ' + JSON.stringify(d));\n}\n\n// คำนวณค่าพลังงานต่อ interval (5 วิ)\nconst INTERVAL_SEC   = 5;\nconst COST_PER_KWH   = 4.5;   // บาท/kWh (อัตรา MEA)\nconst energyKwh      = (d.P_kw * INTERVAL_SEC) / 3600;\nconst costBaht       = energyKwh * COST_PER_KWH;\n\n// กำหนด alert level\nlet alertLevel, alertMsg;\nif (d.P_kw > 8.5) {\n  alertLevel = 'HIGH';\n  alertMsg   = 'พลังงานสูงเกินกำหนด: ' + d.P_kw + ' kW (เกิน 8.5 kW)';\n} else if (d.P_kw > 7.0) {\n  alertLevel = 'WARN';\n  alertMsg   = 'พลังงานเริ่มสูง: ' + d.P_kw + ' kW';\n} else {\n  alertLevel = 'OK';\n  alertMsg   = 'ปกติ: ' + d.P_kw + ' kW';\n}\n\n// ตรวจแรงดันผิดปกติ\nconst voltAlert = (d.V_rms < 207 || d.V_rms > 233)\n  ? 'แรงดันผิดปกติ: ' + d.V_rms + ' V'\n  : null;\n\nreturn [{\n  json: {\n    // ข้อมูลเดิมจาก PLC\n    timestamp:   d.timestamp,\n    device_id:   d.device_id,\n    mode:        d.mode,\n    P_kw:        d.P_kw,\n    V_rms:       d.V_rms,\n    I_A:         d.I_A,\n    Hz:          d.Hz,\n    load_pct:    d.load_pct ?? null,\n    // ค่าที่คำนวณเพิ่ม\n    energy_kwh:  parseFloat(energyKwh.toFixed(6)),\n    cost_baht:   parseFloat(costBaht.toFixed(4)),\n    // alert\n    alert_level: alertLevel,\n    alert_msg:   alertMsg,\n    volt_alert:  voltAlert,\n    has_alert:   alertLevel !== 'OK' || voltAlert !== null,\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "1a2b3c4d-0002-0002-0002-000000000002",
      "name": "Parse & Enrich",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 300]
    },
