    {
        "id": "n_fn_status",
        "type": "function",
        "z": "tab_fx3u_sim",
        "name": "Format Status",
        "func": "var d = msg.payload;\nvar heavy = (d.mode === 'heavy');\nvar bg  = heavy ? '#ffebee' : '#e8f5e9';\nvar clr = heavy ? '#c62828' : '#2e7d32';\nvar lbl = heavy ? 'HEAVY LOAD' : 'NORMAL LOAD';\n\nmsg.payload =\n    '<div style=\"background:' + bg + ';padding:10px;border-radius:6px;\">' +\n    '<div style=\"font-size:1.3em;font-weight:bold;color:' + clr + ';margin-bottom:8px;\">' + lbl + '</div>' +\n    '<table style=\"width:100%;border-collapse:collapse;text-align:center;\">' +\n    '<tr style=\"background:#e3f2fd;\">' +\n    '<th style=\"padding:4px;\">Voltage</th><th>Current</th><th>Frequency</th><th>Active Power</th><th>PF</th>' +\n    '</tr>' +\n    '<tr style=\"font-size:1.5em;font-weight:bold;\">' +\n    '<td style=\"color:#1565c0;\">' + d.voltage + ' V</td>' +\n    '<td style=\"color:#e65100;\">' + d.current + ' A</td>' +\n    '<td style=\"color:#4a148c;\">' + d.frequency + ' Hz</td>' +\n    '<td style=\"color:#1b5e20;\">' + d.activePower + ' W</td>' +\n    '<td style=\"color:#33691e;\">' + d.powerFactor + '</td>' +\n    '</tr>' +\n    '</table>' +\n    '<div style=\"margin-top:6px;font-size:0.8em;color:#90a4ae;font-family:monospace;\">' +\n    'Modbus HR: D0=' + d.registers[0] +\n    ' D1=' + d.registers[1] +\n    ' D2=' + d.registers[2] +\n    ' D3=' + d.registers[3] +\n    ' D4=' + d.registers[4] +\n    ' D5=' + d.registers[5] +\n    '   ' + d.timestamp +\n    '</div></div>';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 580,
        "y": 380,
        "wires": [
            [
                "n_txt_status"
            ]
        ]
