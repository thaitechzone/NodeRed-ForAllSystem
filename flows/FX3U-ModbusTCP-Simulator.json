    {
        "id": "n_sim",
        "type": "function",
        "z": "tab_fx3u_sim",
        "name": "FX3U Energy Simulator",
        "func": "// --- State ---\nvar ctx = context.get('sim');\nif (!ctx) {\n    ctx = { mode: 'normal', lastSwitch: Date.now(), interval: 30000 };\n    context.set('sim', ctx);\n}\n\nif (Date.now() - ctx.lastSwitch >= ctx.interval) {\n    ctx.mode = ctx.mode === 'normal' ? 'heavy' : 'normal';\n    ctx.lastSwitch = Date.now();\n    context.set('sim', ctx);\n}\n\nnode.status({\n    fill: ctx.mode === 'heavy' ? 'red' : 'green',\n    shape: 'dot',\n    text: ctx.mode === 'heavy' ? 'Heavy Load' : 'Normal Load'\n});\n\n// --- Profiles ---\nvar profiles = {\n    normal: { V: 220.0, I:  5.5,  F: 50.00, PF: 0.920 },\n    heavy:  { V: 213.5, I: 18.5,  F: 49.75, PF: 0.845 }\n};\nvar b = profiles[ctx.mode];\n\nfunction jitter(val, pct) {\n    return val * (1 + (Math.random() - 0.5) * 2 * pct);\n}\n\nvar V  = parseFloat(jitter(b.V,  0.005).toFixed(1));\nvar I  = parseFloat(jitter(b.I,  0.020).toFixed(2));\nvar F  = parseFloat(jitter(b.F,  0.002).toFixed(2));\nvar PF = parseFloat(Math.min(1.0, jitter(b.PF, 0.008)).toFixed(3));\nvar P  = Math.round(V * I * PF);\nvar S  = Math.round(V * I);\nvar Q  = Math.round(Math.sqrt(Math.max(0, S*S - P*P)));\n\n// --- FX3U D-Register -> Modbus HR ---\n// D0=HR0: Voltage x10    2200 = 220.0V\n// D1=HR1: Current x100    550 = 5.50A\n// D2=HR2: Freq x100      5000 = 50.00Hz\n// D3=HR3: ActivePower(W) 1117 = 1117W\n// D4=HR4: PF x1000        920 = 0.920\n// D5=HR5: LoadState(0/1)    1 = Heavy\nvar regs = [\n    Math.round(V  * 10),\n    Math.round(I  * 100),\n    Math.round(F  * 100),\n    P,\n    Math.round(PF * 1000),\n    ctx.mode === 'heavy' ? 1 : 0\n];\n\nvar data = {\n    voltage:       V,\n    current:       I,\n    frequency:     F,\n    activePower:   P,\n    reactivePower: Q,\n    apparentPower: S,\n    powerFactor:   PF,\n    mode:          ctx.mode,\n    registers:     regs,\n    timestamp:     new Date().toLocaleTimeString('th-TH')\n};\n\nreturn [\n    { payload: V    },\n    { payload: I    },\n    { payload: F    },\n    { payload: P    },\n    { payload: data }\n];",
        "outputs": 5,
        "noerr": 0,
        "x": 340,
        "y": 200,
        "wires": [
            [
                "n_g_volt"
            ],
            [
                "n_g_curr"
            ],
            [
                "n_g_freq"
            ],
            [
                "n_g_pwr"
            ],
            [
                "n_fn_status",
                "n_fn_chart",
                "n_fn_modbus_prep",
                "n_debug"
            ]
        ]
