    {
        "id": "n_fn_status",
        "type": "function",
        "z": "tab_mb_reader",
        "name": "Format Status",
        "func": "var d = msg.payload;\nvar heavy = (d.mode === 'heavy');\nvar bg  = heavy ? '#ffebee' : '#e8f5e9';\nvar clr = heavy ? '#c62828' : '#2e7d32';\nvar lbl = heavy ? 'HEAVY LOAD' : 'NORMAL LOAD';\nvar ts  = new Date(d.timestamp).toLocaleTimeString('th-TH');\n\nmsg.payload =\n    '<div style=\"background:' + bg + ';padding:10px;border-radius:6px;\">' +\n    '<div style=\"font-size:1.3em;font-weight:bold;color:' + clr + ';margin-bottom:8px;\">' + lbl + '</div>' +\n    '<table style=\"width:100%;border-collapse:collapse;text-align:center;\">' +\n    '<tr style=\"background:#e3f2fd;\">' +\n    '<th style=\"padding:4px;\">Voltage</th><th>Current</th><th>Frequency</th><th>Active Power</th><th>PF</th>' +\n    '</tr>' +\n    '<tr style=\"font-size:1.5em;font-weight:bold;\">' +\n    '<td style=\"color:#1565c0;\">' + d.voltage + ' V</td>' +\n    '<td style=\"color:#e65100;\">' + d.current + ' A</td>' +\n    '<td style=\"color:#4a148c;\">' + d.frequency + ' Hz</td>' +\n    '<td style=\"color:#1b5e20;\">' + d.activePower + ' W</td>' +\n    '<td style=\"color:#33691e;\">' + d.powerFactor + '</td>' +\n    '</tr>' +\n    '<tr style=\"font-size:0.9em;color:#546e7a;text-align:center;\">' +\n    '<td>Apparent: ' + d.apparentPower + ' VA</td>' +\n    '<td colspan=\"2\">Reactive: ' + d.reactivePower + ' VAR</td>' +\n    '<td colspan=\"2\">Updated: ' + ts + '</td>' +\n    '</tr>' +\n    '</table>' +\n    '<div style=\"margin-top:8px;padding:6px;background:#e8eaf6;border-radius:4px;font-size:0.85em;font-family:monospace;\">' +\n    'HR: [' + d.registers.join(', ') + ']&nbsp;&nbsp;' +\n    'MQTT: energy/meter/{voltage|current|frequency|power|pf|loadstate|mode|json}' +\n    '</div></div>';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 620,
        "y": 380,
        "wires": [
            ["n_txt_status"]
        ]
    },
