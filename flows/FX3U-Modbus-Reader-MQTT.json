    {
        "id": "n_mbread",
        "type": "modbus-read",
        "z": "tab_mb_reader",
        "name": "Read HR0-HR5 FC3",
        "topic": "energy",
        "showStatusActivities": false,
        "logIOActivities": false,
        "showErrors": true,
        "showWarnings": true,
        "unitid": "1",
        "dataType": "HoldingRegister",
        "adr": "0",
        "quantity": "6",
        "rate": "2",
        "rateUnit": "s",
        "readOnce": false,
        "delayOnStart": true,
        "startDelayTime": 8,
        "server": "cfg_mbcli",
        "useIOFile": false,
        "ioFile": "",
        "useIOForPayload": false,
        "emptyMsgOnFail": false,
        "keepMsgProperties": false,
        "x": 170,
        "y": 200,
        "wires": [
            ["n_parse"],
            []
        ]
    },
    {
        "id": "n_parse",
        "type": "function",
        "z": "tab_mb_reader",
        "name": "Parse Registers",
        "func": "// รับ payload จาก modbus-read\n// รองรับทุก format: Array, Buffer, TypedArray, {data:[]}\nvar raw = msg.payload;\n\nif (raw && raw.data)          raw = raw.data;\nif (Buffer.isBuffer(raw)) {\n    var tmp = [];\n    for (var i = 0; i < raw.length; i += 2)\n        tmp.push(raw.readUInt16BE(i));\n    raw = tmp;\n}\nif (!Array.isArray(raw)) raw = Array.from(raw);\n\nif (!raw || raw.length < 6) {\n    node.warn('Modbus: ได้รับข้อมูลไม่ครบ (length=' + (raw ? raw.length : 0) + ')');\n    return null;\n}\n\n// แปลงค่า Register กลับเป็นหน่วยจริง\n// D0=HR0: Voltage x10    D1=HR1: Current x100\n// D2=HR2: Freq x100      D3=HR3: Active Power(W)\n// D4=HR4: PF x1000       D5=HR5: LoadState(0/1)\nvar V  = raw[0] / 10;\nvar I  = raw[1] / 100;\nvar F  = raw[2] / 100;\nvar P  = raw[3];\nvar PF = raw[4] / 1000;\nvar LS = raw[5];\n\nvar S  = Math.round(V * I * 10) / 10;\nvar Q  = Math.round(Math.sqrt(Math.max(0, S*S - P*P)) * 10) / 10;\n\nnode.status({\n    fill:  LS === 1 ? 'red' : 'green',\n    shape: 'dot',\n    text:  (LS === 1 ? 'Heavy' : 'Normal') +\n           ' | ' + V + 'V ' + I + 'A ' + P + 'W'\n});\n\nvar data = {\n    voltage:       V,\n    current:       I,\n    frequency:     F,\n    activePower:   P,\n    reactivePower: Q,\n    apparentPower: S,\n    powerFactor:   PF,\n    loadState:     LS,\n    mode:          LS === 1 ? 'heavy' : 'normal',\n    registers:     raw.slice(0, 6),\n    timestamp:     new Date().toISOString()\n};\n\nmsg.payload = data;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 370,
        "y": 200,
        "wires": [
            ["n_g_volt", "n_g_curr", "n_g_freq", "n_g_pwr",
             "n_fn_status", "n_fn_chart", "n_fn_mqtt", "n_debug"]
        ]
    },
