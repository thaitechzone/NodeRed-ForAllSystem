    {
        "id": "n_fn_chart",
        "type": "function",
        "z": "tab_mb_reader",
        "name": "Chart Prep",
        "func": "var d = msg.payload;\nreturn [[\n    { topic: 'Voltage (V)',  payload: d.voltage },\n    { topic: 'Current x10', payload: parseFloat((d.current * 10).toFixed(1)) },\n    { topic: 'Power / 10',  payload: Math.round(d.activePower / 10) }\n]];",
        "outputs": 1,
        "noerr": 0,
        "x": 600,
        "y": 460,
        "wires": [
            ["n_chart"]
        ]
    },
    {
        "id": "n_chart",
        "type": "ui_chart",
        "z": "tab_mb_reader",
        "name": "",
        "group": "grp_rd_chart",
        "order": 1,
        "width": "12",
        "height": "6",
        "label": "Voltage | Current x10 | Power / 10",
        "chartType": "line",
        "legend": "true",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "Waiting for Modbus data...",
        "dot": false,
        "ymin": "0",
        "ymax": "250",
        "removeOlder": "5",
        "removeOlderPoints": "",
        "removeOlderUnit": "60",
        "cutout": 0,
        "useOneColor": false,
        "useUTC": false,
        "colors": ["#1565c0", "#e65100", "#2e7d32", "#d62728", "#9467bd"],
        "useDifferentColor": false,
        "x": 810,
        "y": 460,
        "wires": [
            []
        ]
    },
    {
        "id": "n_fn_mqtt",
        "type": "function",
        "z": "tab_mb_reader",
        "name": "Build MQTT Messages",
        "func": "var d = msg.payload;\nvar base = 'energy/meter/';\n\nreturn [[\n    { topic: base + 'voltage',   payload: String(d.voltage),      qos: 0, retain: true },\n    { topic: base + 'current',   payload: String(d.current),      qos: 0, retain: true },\n    { topic: base + 'frequency', payload: String(d.frequency),    qos: 0, retain: true },\n    { topic: base + 'power',     payload: String(d.activePower),  qos: 0, retain: true },\n    { topic: base + 'pf',        payload: String(d.powerFactor),  qos: 0, retain: true },\n    { topic: base + 'loadstate', payload: String(d.loadState),    qos: 0, retain: true },\n    { topic: base + 'mode',      payload: d.mode,                 qos: 0, retain: true },\n    { topic: base + 'json',      payload: JSON.stringify({\n        voltage:       d.voltage,\n        current:       d.current,\n        frequency:     d.frequency,\n        activePower:   d.activePower,\n        reactivePower: d.reactivePower,\n        apparentPower: d.apparentPower,\n        powerFactor:   d.powerFactor,\n        loadState:     d.loadState,\n        mode:          d.mode,\n        timestamp:     d.timestamp\n    }), qos: 0, retain: true }\n]];",
        "outputs": 1,
        "noerr": 0,
        "x": 630,
        "y": 560,
        "wires": [
            ["n_mqtt_out"]
        ]
    },
