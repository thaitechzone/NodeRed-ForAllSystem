      ]
    },
    "IF: Temp > 35°C?": {
      "main": [
        [
          { "node": "Set Temp Alert Message", "type": "main", "index": 0 }
        ],
        []
      ]
    },
    "Webhook: Status": {
      "main": [
        [
          { "node": "Extract Status Fields", "type": "main", "index": 0 }
        ]
      ]
    },
    "Extract Status Fields": {
      "main": [
        [
          { "node": "IF: Device Offline?", "type": "main", "index": 0 },
          { "node": "Respond 200 OK (Status)", "type": "main", "index": 0 }
        ]
      ]
    },
    "IF: Device Offline?": {
      "main": [
        [
          { "node": "Set Offline Alert Message", "type": "main", "index": 0 }
