    {
        "id": "note-n8n-control",
        "type": "comment",
        "z": "tab-smartfarm-001",
        "name": "=== 2. รับคำสั่ง Auto-Control จาก N8N → สั่ง Relay ===",
        "info": "N8N ส่ง HTTP POST มาที่ /smartfarm/relay-control\nNode-RED รับ → validate → publish MQTT → ESP32",
        "x": 290,
        "y": 340,
        "wires": []
    },
    {
        "id": "http-in-n8n-control",
        "type": "http in",
        "z": "tab-smartfarm-001",
        "name": "POST /smartfarm/relay-control",
        "url": "/smartfarm/relay-control",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 200,
        "y": 400,
        "wires": [["func-validate-relay-cmd"]]
    },
    {
        "id": "func-validate-relay-cmd",
        "type": "function",
        "z": "tab-smartfarm-001",
        "name": "Validate & Format Relay Command",
        "func": "const body = msg.payload;\n\n// Validate required fields\nif (!body || body.command !== 'relay_control' || !body.relays) {\n    node.warn('Invalid command: ' + JSON.stringify(body));\n    const errRes = { payload: { status: 'error', message: 'Invalid command format' }, statusCode: 400 };\n    return [null, errRes];\n}\n\n// Build MQTT publish message\nconst mqttMsg = {\n    payload: {\n        command: 'relay_control',\n        relays: {\n            relay1_pump:   body.relays.relay1_pump   !== undefined ? body.relays.relay1_pump   : false,\n            relay2_fan:    body.relays.relay2_fan    !== undefined ? body.relays.relay2_fan    : false,\n            relay3_heater: body.relays.relay3_heater !== undefined ? body.relays.relay3_heater : false\n        }\n    },\n    topic: ''\n};\n\n// Build HTTP response back to N8N\nconst resMsg = {\n    payload: {\n        status: 'ok',\n        action:       body.reason       || 'manual',\n        triggered_by: body.triggered_by || 'unknown',\n        relays:       mqttMsg.payload.relays,\n        timestamp:    new Date().toISOString()\n    },\n    statusCode: 200\n};\n\nnode.status({ fill: 'green', shape: 'dot', text: body.reason || 'command received' });\nreturn [mqttMsg, resMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 400,
        "wires": [
            ["debug-n8n-cmd-received", "mqtt-out-control"],
            ["http-res-n8n-control"]
        ]
    },
