# ════════════════════════════════════════════════════════
#  .env.example — Template สำหรับตั้งค่าระบบ
#
#  วิธีใช้:
#    1. คัดลอกไฟล์นี้: cp .env.example .env
#    2. แก้ไขค่าที่มี <...> ทุกตัวให้ครบ
#    3. ห้าม commit ไฟล์ .env ขึ้น Git
# ════════════════════════════════════════════════════════

# ─── Timezone ────────────────────────────────────────────
TZ=Asia/Bangkok

# ─── Ngrok ───────────────────────────────────────────────
# 1. สมัครฟรีที่ https://dashboard.ngrok.com/signup
# 2. Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
# 3. Static Domain: https://dashboard.ngrok.com/domains → New Domain
NGROK_AUTHTOKEN=<your-ngrok-authtoken>
NGROK_DOMAIN=<your-subdomain>.ngrok-free.dev
NGROK_URL=https://<your-subdomain>.ngrok-free.dev

# ─── N8N ─────────────────────────────────────────────────
# Random key สำหรับเข้ารหัส credentials ใน N8N (ต้องเปลี่ยน)
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
N8N_ENCRYPTION_KEY=<random-32-char-hex-string>

# ─── Node-RED Admin Auth ─────────────────────────────────
# สร้าง password hash ด้วย:
#   docker run --rm -it nodered/node-red node-red-admin hash-pw
# ผลลัพธ์จะขึ้นต้นด้วย $2b$
NR_ADMIN_USERNAME=admin
NR_ADMIN_PASSWORD_HASH=<bcrypt-hash-of-your-password>
