# Node-RED + N8N + MQTT + ngrok
# คัดลอก: cp .env.example .env

# Timezone
TZ=Asia/Bangkok

# ngrok Authtoken
# ได้จาก: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-authtoken-here

# ngrok Domain (ไม่มี https://)
# สร้างที่: https://dashboard.ngrok.com/cloud-edge/domains
NGROK_DOMAIN=your-domain.ngrok-free.dev

# ngrok URL (มี https://)
# สร้างจาก NGROK_DOMAIN
NGROK_URL=https://your-domain.ngrok-free.dev

# N8N Encryption Key (32 hex characters)
# สร้าง: powershell -Command "-join ((1..32) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })"
N8N_ENCRYPTION_KEY=change-this-to-random-32-char-string
