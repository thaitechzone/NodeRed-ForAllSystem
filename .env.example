# Node-RED + N8N + MQTT + ngrok + Ollama + PostgreSQL
# คัดลอก: cp .env.example .env  แล้วแก้ค่าให้ถูกต้อง

# ── Timezone ──────────────────────────────────────────────
TZ=Asia/Bangkok

# ── ngrok ─────────────────────────────────────────────────
# Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-authtoken-here

# Domain (ไม่มี https://)
# สร้างที่: https://dashboard.ngrok.com/cloud-edge/domains
NGROK_DOMAIN=your-domain.ngrok-free.dev

# URL (มี https://)
NGROK_URL=https://your-domain.ngrok-free.dev

# ── N8N ───────────────────────────────────────────────────
# Encryption Key (32 hex characters)
# สร้าง (Linux/Mac): openssl rand -hex 16
# สร้าง (Windows PS): -join ((1..32)|%{'{0:x}'-f(Get-Random -Max 16)})
N8N_ENCRYPTION_KEY=change-this-to-random-32-char-hex

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=iot_db
