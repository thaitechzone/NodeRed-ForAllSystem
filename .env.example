# ╔════════════════════════════════════════════════════════════════════════╗
# ║          NodeRED + N8N + Home Assistant + InfluxDB + Grafana           ║
# ║                    Nginx Proxy Manager + Cloudflare                    ║
# ╚════════════════════════════════════════════════════════════════════════╝
#
# 📋 ขั้นตอนเริ่มต้น:
# ────────────────────────────────────────────────────────────
# 1. Copy ไฟล์นี้:
#    Windows:   copy .env.example .env
#    Mac/Linux: cp .env.example .env
#
# 2. เปิด .env และแก้ไขค่าต่อไปนี้ (ดูคำสั่งใน comments):
#    ✓ NODERED_PASSWORD_HASH (required)
#    ✓ N8N_ENCRYPTION_KEY (required)
#    ✓ INFLUXDB_PASSWORD (required)
#    ✓ INFLUXDB_ORG (required)
#    ✓ INFLUXDB_BUCKET (required)
#    ✓ INFLUXDB_ADMIN_TOKEN (required)
#    ✓ GRAFANA_ADMIN_PASSWORD (required)
#
# 3. เริ่มขึ้น:
#    docker compose up -d
#
# 4. ทดสอบ:
#    - Node-RED: http://localhost:1880
#    - N8N: http://localhost:5678
#    - Grafana: http://localhost:3000
#
# 📖 สำหรับตัวอย่างและคำแนะนำเพิ่มเติม ดู:
#    - TESTING_GUIDE.md
#    - NODERED_PASSWORD_SETUP.md
#    - INFLUXDB_SETUP.md
#
# ╚════════════════════════════════════════════════════════════════════════╝

# ── Timezone ──────────────────────────────────────────────
TZ=Asia/Bangkok

# ── Node-RED Login ────────────────────────────────────────
# ชื่อผู้ใช้ Node-RED (default: admin)
NODERED_USERNAME=admin

# 🔐 Password Hash - สร้างด้วย Command Line:
#
# Windows PowerShell:
#   1. npm install -g node-red-admin
#   2. node-red-admin hash-pw
#   3. พิมพ์รหัสผ่าน 2 ครั้ง
#   4. Copy hash ที่ได้
#
# Mac/Linux Terminal:
#   1. npm install -g node-red-admin
#   2. node-red-admin hash-pw
#   3. พิมพ์รหัสผ่าน 2 ครั้ง
#   4. Copy hash ที่ได้
#
# ⚠️ Hash ต้อง:
#   - เริ่มด้วย $2a$ หรือ $2b$
#   - ยาว 60 ตัวอักษร
#   - ไม่มี space หรือ newline
#
# ตัวอย่าง hash (password: "admin"):
NODERED_PASSWORD_HASH=$2a$08$UL6Zwie/yZHpRf4ugI0fq.ktr8VgiYl4OtAQidorGQ7Y6n5nLIFVO

# 📖 อ่านคู่มือละเอียด: SETUP_CREDENTIALS.md

# ── Cloudflare Tunnel (Optional) ──────────────────────────
# ⚠️ สำหรับ Production เท่านั้น (ไม่ต้องใช้ใน Docker Desktop testing)
#
# ขั้นตอน:
# 1. เข้า https://one.dash.cloudflare.com
# 2. Networks → Tunnels
# 3. Create Tunnel → ตั้งชื่อ → เลือก Docker
# 4. Copy token ที่ได้มา ใส่ลงมา
#
# วิธีค้นหา Token:
#   - ไปที่ https://one.dash.cloudflare.com/networks/tunnels
#   - ค้นหา tunnel ที่สร้าง
#   - คลิก "Configure"
#   - Copy token ใน Docker section
#
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# 📖 Setup Guide: DOCKER_DESKTOP_TESTING.md

# ── N8N Domain ────────────────────────────────────────────
# โดเมนสำหรับ N8N (ตั้งใน Cloudflare Dashboard)
# ตัวอย่าง: n8n.yourdomain.com
#
# ขั้นตอน:
# 1. ใน Cloudflare Dashboard → Tunnels
# 2. เลือก tunnel ของ project นี้
# 3. Public Hostname:
#    - Hostname: n8n.yourdomain.com
#    - Service: http://nginx-proxy-manager:80
# 4. Save
#
N8N_DOMAIN=n8n.yourdomain.com

# ── N8N ───────────────────────────────────────────────────
# 🔐 Encryption Key - สร้างด้วยคำสั่ง:
#
# Windows PowerShell:
#   [System.Guid]::NewGuid().ToString().Replace("-","").Substring(0,32)
#
# Mac/Linux Terminal:
#   openssl rand -hex 16
#
N8N_ENCRYPTION_KEY=change-this-to-random-32-char-hex

# ── InfluxDB ──────────────────────────────────────────────
# Username สำหรับ InfluxDB admin
INFLUXDB_USERNAME=admin
# Password สำหรับ InfluxDB admin
INFLUXDB_PASSWORD=change-this-strong-password
#
# 🔐 Organization, Bucket, Token - สร้างด้วยคำสั่ง:
#
# Windows PowerShell:
#   [System.Guid]::NewGuid().ToString().Replace("-","")
#
# Mac/Linux Terminal:
#   openssl rand -hex 32
#
# ⚠️ ต้องใส่ค่าทั้งสามตัวแปร (ไม่ comment out):
INFLUXDB_ORG=iot_org
INFLUXDB_BUCKET=iot_bucket
INFLUXDB_ADMIN_TOKEN=change-this-to-random-64-char-hex
#
# 📖 ดู: INFLUXDB_SETUP.md

# ── Grafana ───────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-strong-password
