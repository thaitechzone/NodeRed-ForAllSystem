# NodeRED + N8N + Home Assistant + InfluxDB + Grafana + Nginx Proxy Manager
# คัดลอก: cp .env.example .env  แล้วแก้ค่าให้ถูกต้อง

# ── Timezone ──────────────────────────────────────────────
TZ=Asia/Bangkok

# ── Cloudflare Tunnel ─────────────────────────────────────
# 1. เข้า https://one.dash.cloudflare.com → Networks → Tunnels
# 2. Create a tunnel → ตั้งชื่อ → เลือก Docker
# 3. Copy token จาก command ที่ได้มา
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# โดเมนสำหรับ N8N (ตั้งใน Cloudflare Dashboard)
# Public Hostname: n8n.yourdomain.com → http://nginx-proxy-manager:80
N8N_DOMAIN=n8n.yourdomain.com

# ── N8N ───────────────────────────────────────────────────
# สร้าง Encryption Key (Linux/Mac): openssl rand -hex 16
N8N_ENCRYPTION_KEY=change-this-to-random-32-char-hex

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=iot_db

# ── InfluxDB ──────────────────────────────────────────────
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-this-strong-password
INFLUXDB_ORG=iot_org
INFLUXDB_BUCKET=iot_bucket
# สร้าง Token (Linux/Mac): openssl rand -hex 32
INFLUXDB_ADMIN_TOKEN=change-this-to-random-64-char-hex

# ── Grafana ───────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-strong-password
