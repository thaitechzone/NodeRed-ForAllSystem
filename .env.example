# ════════════════════════════════════════════════════════
#  Environment Configuration — EXAMPLE
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าให้ตรงกับ environment ของคุณ
#  cp .env.example .env
# ════════════════════════════════════════════════════════

# ─── Timezone ────────────────────────────────────────────
TZ=Asia/Bangkok

# ─── N8N ─────────────────────────────────────────────────
# ถ้าใช้ ngrok ให้เปลี่ยน NGROK_URL เป็น URL จริง เช่น https://abc123.ngrok-free.app
# ถ้าใช้ local เท่านั้น ปล่อยค่า default ไว้ได้เลย
NGROK_URL=https://your-subdomain.ngrok-free.app

# สร้าง key ด้วยคำสั่งนี้ใน CMD แล้วนำผลลัพธ์มาใส่:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
N8N_ENCRYPTION_KEY=change-this-to-random-32-char-string

# ─── OPC Server ──────────────────────────────────────────
# IP ของเครื่องที่รัน OPC Server (ไม่ใช่ localhost เพราะ Node-RED อยู่ใน Docker)
OPC_SERVER_IP=192.168.1.100
OPC_SERVER_PORT=4840
