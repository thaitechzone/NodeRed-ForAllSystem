[
    {
        "id": "tab-plc-opc",
        "type": "tab",
        "label": "PLC OPC-UA → MQTT",
        "disabled": false,
        "info": "อ่านค่าจาก OPC Server แล้ว publish ไป MQTT\nรับ command จาก MQTT แล้วเขียนกลับ OPC"
    },
    {
        "id": "mqtt-broker-local",
        "type": "mqtt-broker",
        "name": "Mosquitto Local",
        "broker": "mosquitto",
        "port": "1883",
        "clientid": "nodered-client",
        "autoConnect": true,
        "usetls": false,
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "inject-poll",
        "type": "inject",
        "z": "tab-plc-opc",
        "name": "Poll OPC ทุก 5 วินาที",
        "props": [{"p": "payload"}],
        "repeat": "5",
        "once": true,
        "onceDelay": "2",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 160,
        "y": 100,
        "wires": [["opc-read-temp"]]
    },
    {
        "id": "opc-read-temp",
        "type": "OpcUa-Client",
        "z": "tab-plc-opc",
        "name": "อ่าน Temperature",
        "endpoint": "opc.tcp://192.168.1.100:4840",
        "action": "read",
        "deadbandtype": "a",
        "deadbandvalue": "1",
        "time": "5",
        "timeUnit": "s",
        "certificate": "n",
        "localfile": "",
        "securityPolicy": "None",
        "securityMode": "None",
        "item": {
            "item": "ns=2;s=Temperature"
        },
        "x": 390,
        "y": 100,
        "wires": [["fn-format-temp"]]
    },
    {
        "id": "fn-format-temp",
        "type": "function",
        "z": "tab-plc-opc",
        "name": "แปลงเป็น JSON",
        "func": "var value = msg.payload;\nif (value === null || value === undefined) return null;\n\nmsg.payload = JSON.stringify({\n    value: value,\n    unit: '°C',\n    timestamp: new Date().toISOString(),\n    source: 'PLC'\n});\nmsg.topic = 'plc/data/temperature';\nreturn msg;",
        "outputs": 1,
        "x": 610,
        "y": 100,
        "wires": [["mqtt-pub-data", "debug-opc"]]
    },
    {
        "id": "mqtt-pub-data",
        "type": "mqtt out",
        "z": "tab-plc-opc",
        "name": "Publish → plc/data/#",
        "topic": "",
        "qos": "1",
        "retain": "false",
        "respTopic": "",
        "broker": "mqtt-broker-local",
        "x": 840,
        "y": 100,
        "wires": []
    },
    {
        "id": "debug-opc",
        "type": "debug",
        "z": "tab-plc-opc",
        "name": "Debug OPC Value",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "x": 840,
        "y": 160,
        "wires": []
    },
    {
        "id": "mqtt-sub-cmd",
        "type": "mqtt in",
        "z": "tab-plc-opc",
        "name": "Subscribe ← plc/command/#",
        "topic": "plc/command/#",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt-broker-local",
        "x": 170,
        "y": 300,
        "wires": [["fn-route-cmd"]]
    },
    {
        "id": "fn-route-cmd",
        "type": "function",
        "z": "tab-plc-opc",
        "name": "Route Command",
        "func": "var topic = msg.topic;\nvar payload = msg.payload;\n\n// แปลง topic เป็น OPC Node ID\nvar nodeMap = {\n    'plc/command/setpoint': 'ns=2;s=Setpoint',\n    'plc/command/start':    'ns=2;s=StartCommand',\n    'plc/command/stop':     'ns=2;s=StopCommand'\n};\n\nvar nodeId = nodeMap[topic];\nif (!nodeId) {\n    node.warn('ไม่รู้จัก command topic: ' + topic);\n    return null;\n}\n\nmsg.payload = {\n    item: nodeId,\n    value: payload.value !== undefined ? payload.value : payload\n};\n\nreturn msg;",
        "outputs": 1,
        "x": 420,
        "y": 300,
        "wires": [["opc-write-cmd"]]
    },
    {
        "id": "opc-write-cmd",
        "type": "OpcUa-Client",
        "z": "tab-plc-opc",
        "name": "เขียนค่า OPC",
        "endpoint": "opc.tcp://192.168.1.100:4840",
        "action": "write",
        "certificate": "n",
        "securityPolicy": "None",
        "securityMode": "None",
        "x": 640,
        "y": 300,
        "wires": [["debug-cmd"]]
    },
    {
        "id": "debug-cmd",
        "type": "debug",
        "z": "tab-plc-opc",
        "name": "Debug Write Result",
        "active": true,
        "tosidebar": true,
        "complete": "payload",
        "x": 860,
        "y": 300,
        "wires": []
    }
]
